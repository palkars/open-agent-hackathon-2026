# Copy to .env (gitignored) and fill in your own values. Never commit .env.

# Evidence source for ResearchOS: local (research-os/data/*.json) or zetaris.
DATA_SOURCE=local

# Zetaris direct REST API (participant guide 1.9). Create the API key yourself
# in the Zetaris web interface; ORG_ID is 1 on a local install.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Where the research tables live: researchos_files (CSV file tables, from
# zetaris-setup --files) or researchos (inline-data views, from zetaris-setup).
ZETARIS_RESEARCH_CONTAINER=researchos_files

# Meterless Runtime (Nightshift), the primary model route. Copy the URL and API
# key from Nightshift's Console. meterless/auto is a routing mode; pin a
# Nemotron-backed route for the NVIDIA award.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# Optional direct route (e.g. NVIDIA's API), used as a fallback only when the
# Meterless Runtime can't be reached. All three must come from the same route.
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=

# auto (default), meterless, direct or offline.
RESEARCH_OS_MODEL_ROUTE=auto
